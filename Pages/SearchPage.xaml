<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="parcel_station1.Pages.SearchPage"
             BackgroundColor="#F5F7FB"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="210,*">

        <!-- Top notification -->
        <Border x:Name="TopNotification"
                Grid.RowSpan="2"
                IsVisible="False"
                Background="#22C55E"
                StrokeThickness="0"
                Margin="20,52,20,0"
                Padding="16,12"
                VerticalOptions="Start"
                TranslationY="-120"
                ZIndex="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Label x:Name="TopNotificationLabel"
                   Text="Notification"
                   TextColor="White"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Header -->
        <Grid Padding="24,48,24,20">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0.0" />
                    <GradientStop Color="#1E3A8A" Offset="0.55" />
                    <GradientStop Color="#2563EB" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <VerticalStackLayout Spacing="18">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="WelcomeLabel"
                               Text="Welcome back"
                               FontSize="14"
                               TextColor="#DBEAFE" />

                        <Label Text="My Parcels"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Background="#2563EB"
                            Stroke="#93C5FD"
                            StrokeThickness="1.5"
                            WidthRequest="50"
                            HeightRequest="50"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>

                        <Label Text="≡"
                               FontSize="18"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

                <!-- Search -->
                <Border Background="White"
                        Stroke="#BFDBFE"
                        StrokeThickness="1.5"
                        Padding="16,0"
                        HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          VerticalOptions="Center">
                        <Label Text="⌕"
                               FontSize="20"
                               TextColor="#2563EB"
                               VerticalOptions="Center" />

                        <Entry Grid.Column="1"
                               x:Name="ParcelCodeEntry"
                               Placeholder="Enter tracking number"
                               PlaceholderColor="#94A3B8"
                               TextColor="#111827"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />

                        <Label Grid.Column="2"
                               Text="⌁"
                               FontSize="18"
                               TextColor="#2563EB"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </Grid>

        <!-- Main body -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                StrokeThickness="0"
                Padding="22,28,22,100"
                Margin="0,-18,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32,32,0,0" />
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Spacing="24">

                    <!-- Stats -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="12"
                          Margin="0,6,0,0">

                        <Border Background="#FFF7ED"
                                Padding="16"
                                StrokeThickness="0"
                                HeightRequest="118">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="⏳" FontSize="22" />
                                <Label x:Name="PendingCountLabel"
                                       Text="0"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label Text="Pending"
                                       FontSize="14"
                                       TextColor="#B45309" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#EEF2FF"
                                Padding="16"
                                StrokeThickness="0"
                                HeightRequest="118">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="📦" FontSize="22" />
                                <Label x:Name="ReadyCountLabel"
                                       Text="0"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label Text="Ready"
                                       FontSize="14"
                                       TextColor="#4F46E5" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#ECFDF5"
                                Padding="16"
                                StrokeThickness="0"
                                HeightRequest="118">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="✅" FontSize="22" />
                                <Label x:Name="CollectedCountLabel"
                                       Text="0"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label Text="Collected"
                                       FontSize="14"
                                       TextColor="#15803D" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Features -->
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Features"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#111827" />

                        <Grid ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="10">

                            <Border Background="White"
                                    Padding="14"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10"
                                                     HorizontalOptions="Center">
                                    <Label Text="🔍"
                                           FontSize="22"
                                           HorizontalOptions="Center" />
                                    <Label Text="Search"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#111827" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSearchClicked" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="White"
                                    Padding="14"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10"
                                                     HorizontalOptions="Center">
                                    <Label Text="📷"
                                           FontSize="22"
                                           HorizontalOptions="Center" />
                                    <Label Text="Scan"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#111827" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnScanQrClicked" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    Padding="14"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10"
                                                     HorizontalOptions="Center">
                                    <Label Text="➕"
                                           FontSize="22"
                                           HorizontalOptions="Center" />
                                    <Label Text="Add"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#111827" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAddParcelClicked" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Grid.Column="3"
                                    Background="White"
                                    Padding="14"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10"
                                                     HorizontalOptions="Center">
                                    <Label Text="🕘"
                                           FontSize="22"
                                           HorizontalOptions="Center" />
                                    <Label Text="History"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#111827" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistoryClicked" />
                                </Border.GestureRecognizers>
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                    <!-- Recent parcel -->
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Recent Parcels"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#111827" />

                        <Border Background="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                                <Border Background="#EEF2FF"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="📦"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontSize="20" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label x:Name="LatestParcelCodeLabel"
                                           Text="Latest parcel"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#111827" />
                                    <Label x:Name="LatestParcelStatusLabel"
                                           Text="Recent parcel activity"
                                           FontSize="12"
                                           TextColor="#6B7280" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       x:Name="LatestParcelTimeLabel"
                                       Text="Now"
                                       FontSize="12"
                                       TextColor="#9CA3AF"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- History preview -->
                    <VerticalStackLayout Spacing="14">
                        <Label Text="History Preview"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#111827" />

                        <Label x:Name="HistoryEmptyLabel"
                               Text="No recent parcel records"
                               FontSize="14"
                               TextColor="#94A3B8"
                               IsVisible="False" />

                        <CollectionView x:Name="HistoryPreviewCollectionView"
                                        IsVisible="False"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="12">

                                            <Border Background="#EFF6FF"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="📦"
                                                       FontSize="18"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="4">
                                                <Label Text="{Binding ParcelCode}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#111827" />
                                                <Label Text="{Binding Subtitle}"
                                                       FontSize="12"
                                                       TextColor="#6B7280" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   TextColor="{Binding StatusColor}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="View Full History"
                                HeightRequest="48"
                                CornerRadius="16"
                                BackgroundColor="#111827"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                Clicked="OnHistoryClicked" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Bottom nav: display only -->
        <Border Grid.RowSpan="2"
                VerticalOptions="End"
                Margin="18,0,18,18"
                Background="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                HeightRequest="74">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,*,*,*"
                  Padding="10,8">

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Opacity="0.55">
                    <Label Text="⌂"
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="#6B7280" />
                    <Label Text="Home"
                           FontSize="11"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="📦"
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="#2563EB" />
                    <Label Text="Orders"
                           FontSize="11"
                           TextColor="#2563EB"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Opacity="0.55">
                    <Label Text="💬"
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="#6B7280" />
                    <Label Text="Messages"
                           FontSize="11"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3"
                                     Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Opacity="0.55">
                    <Label Text="👤"
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="#6B7280" />
                    <Label Text="Profile"
                           FontSize="11"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>