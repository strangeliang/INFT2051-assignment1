<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="parcel_station1.Pages.SearchPage"
             Title="Parcel Station"
             BackgroundColor="#F8F8FA">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,30,24,24"
                                 Spacing="22"
                                 MaximumWidthRequest="900"
                                 HorizontalOptions="Center">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label x:Name="WelcomeLabel"
                               Text="Welcome back"
                               FontSize="14"
                               TextColor="#7A7A7A" />

                        <Label Text="My Parcels"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="Black" />

                        <Label Text="Search and manage your parcel records"
                               FontSize="14"
                               TextColor="#7A7A7A" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Log out"
                            BackgroundColor="Transparent"
                            TextColor="#5B2DFF"
                            FontAttributes="Bold"
                            Padding="0"
                            VerticalOptions="Start"
                            Clicked="OnLogoutClicked" />
                </Grid>

                <!-- Stats cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                    <Frame Grid.Column="0"
                           CornerRadius="18"
                           Padding="16"
                           MinimumHeightRequest="90"
                           HasShadow="False"
                           BackgroundColor="#FFF4E5">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="PendingCountLabel"
                                   Text="0"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Text="Pending"
                                   FontSize="13"
                                   TextColor="#8A6A2F" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1"
                           CornerRadius="18"
                           Padding="16"
                           MinimumHeightRequest="90"
                           HasShadow="False"
                           BackgroundColor="#EEF2FF">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="ReadyCountLabel"
                                   Text="0"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Text="Ready"
                                   FontSize="13"
                                   TextColor="#4F46E5" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="2"
                           CornerRadius="18"
                           Padding="16"
                           MinimumHeightRequest="90"
                           HasShadow="False"
                           BackgroundColor="#ECFDF3">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="CollectedCountLabel"
                                   Text="0"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                            <Label Text="Collected"
                                   FontSize="13"
                                   TextColor="#15803D" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Search card -->
                <Frame CornerRadius="24"
                       Padding="20"
                       HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Search Parcel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="Black" />

                            <Label Text="Enter your pickup code to find parcel details"
                                   FontSize="13"
                                   TextColor="#7A7A7A" />
                        </VerticalStackLayout>

                        <Frame CornerRadius="14"
                               Padding="12,6"
                               HasShadow="False"
                               BackgroundColor="#F3F4F6"
                               BorderColor="#E5E7EB">
                            <Entry x:Name="ParcelCodeEntry"
                                   Placeholder="Enter parcel code (e.g. 1234)"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   PlaceholderColor="#9CA3AF" />
                        </Frame>

                        <Button Text="Search"
                                HeightRequest="52"
                                CornerRadius="14"
                                FontSize="18"
                                FontAttributes="Bold"
                                BackgroundColor="#5B2DFF"
                                TextColor="White"
                                Clicked="OnSearchClicked" />

                        <Button Text="Add Parcel"
                                HeightRequest="48"
                                CornerRadius="14"
                                BackgroundColor="#EDE9FE"
                                TextColor="#5B2DFF"
                                FontAttributes="Bold"
                                Clicked="OnAddParcelClicked" />

                        <Button Text="Scan QR Code"
                                HeightRequest="48"
                                CornerRadius="14"
                                BackgroundColor="#EEF2FF"
                                TextColor="#4F46E5"
                                FontAttributes="Bold"
                                Clicked="OnScanQrClicked" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Top notification -->
        <Border x:Name="TopNotification"
                IsVisible="False"
                BackgroundColor="#22C55E"
                StrokeThickness="0"
                Padding="16,14"
                Margin="12,8,12,0"
                VerticalOptions="Start"
                TranslationY="-120"
                ZIndex="10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔔"
                       FontSize="18"
                       VerticalOptions="Center"
                       TextColor="White" />

                <Label x:Name="TopNotificationLabel"
                       Grid.Column="1"
                       Text="Parcel ready for pickup"
                       TextColor="White"
                       FontSize="15"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>