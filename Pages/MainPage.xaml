<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="parcel_station1.Pages.MainPage"
             BackgroundColor="#2563EB">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0.0" />
            <GradientStop Color="#2563EB" Offset="0.55" />
            <GradientStop Color="#1D4ED8" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="28,48,28,36"
                             Spacing="0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <!-- Logo -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0"
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Grid>
                    <Label Text="📦"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="#2563EB" />
                </Grid>
            </Border>

            <!-- Header -->
            <Label Text="Parcel Station"
                   Margin="0,20,0,0"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <Label Text="Society Delivery Management"
                   Margin="0,8,0,0"
                   FontSize="14"
                   TextColor="#DBEAFE"
                   HorizontalOptions="Center" />

            <!-- Main Card -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="26"
                    Margin="0,34,0,0"
                    WidthRequest="360"
                    HorizontalOptions="Center"
                    Shadow="{OnPlatform iOS='0,6,18,#22000000', Android='0,6,18,#22000000', WinUI='0,6,18,#22000000'}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <!-- Card Title -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="▦"
                               FontSize="22"
                               TextColor="#2563EB"
                               VerticalOptions="Center" />
                        <Label Text="Welcome Back"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Username -->
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                        <Label Text="Username"
                               FontSize="14"
                               TextColor="#334155" />

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                Padding="16,0"
                                HeightRequest="58">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="28,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Label Text="👤"
                                       FontSize="22"
                                       TextColor="#3B82F6"
                                       VerticalOptions="Center" />

                                <Entry Grid.Column="1"
                                       x:Name="UsernameEntry"
                                       Placeholder="Enter your username"
                                       BackgroundColor="Transparent"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="#111827"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Password"
                               FontSize="14"
                               TextColor="#334155" />

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                Padding="16,0"
                                HeightRequest="58">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="28,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Label Text="🔒"
                                       FontSize="22"
                                       TextColor="#3B82F6"
                                       VerticalOptions="Center" />

                                <Entry Grid.Column="1"
                                       x:Name="PasswordEntry"
                                       Placeholder="Enter your password"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="#111827"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button Text="Continue"
                            HeightRequest="56"
                            CornerRadius="18"
                            Margin="0,12,0,0"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            Clicked="OnLoginClicked"
                            Shadow="{OnPlatform iOS='0,4,12,#22000000', Android='0,4,12,#22000000', WinUI='0,4,12,#22000000'}" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             Margin="0,10,0,0"
                             Color="#E5E7EB" />

                    <!-- Register -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="4"
                                           Margin="0,10,0,0">
                        <Label Text="No account yet?"
                               FontSize="14"
                               TextColor="#475569"
                               VerticalOptions="Center" />

                        <Label Text="Register now"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2563EB"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="Secure • Reliable • Community-Friendly"
                   Margin="0,28,0,0"
                   FontSize="13"
                   TextColor="#DBEAFE"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>