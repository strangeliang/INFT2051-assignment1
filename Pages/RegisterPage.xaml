<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="parcel_station1.Pages.RegisterPage"
             Title="Register"
             BackgroundColor="#2563EB"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0.0" />
            <GradientStop Color="#2563EB" Offset="0.55" />
            <GradientStop Color="#1D4ED8" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="28,46,28,32"
                             Spacing="0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <!-- Logo -->
            <Border StrokeThickness="0"
                    Background="White"
                    WidthRequest="92"
                    HeightRequest="92"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Grid>
                    <Label Text="📦"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="#2563EB" />
                </Grid>
            </Border>

            <!-- Header -->
            <Label Text="Parcel"
                   Margin="0,18,0,0"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <Label Text="Create your account"
                   Margin="0,8,0,0"
                   FontSize="15"
                   TextColor="#DBEAFE"
                   HorizontalOptions="Center" />

            <!-- Main Card -->
            <Border Background="White"
                    StrokeThickness="0"
                    Padding="26"
                    Margin="0,30,0,0"
                    WidthRequest="360"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <!-- Card title -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="▦"
                               FontSize="22"
                               TextColor="#2563EB"
                               VerticalOptions="Center" />
                        <Label Text="Register"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Username -->
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                        <Label Text="Username"
                               FontSize="14"
                               TextColor="#334155" />

                        <Border Background="#FFFFFF"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                Padding="16,0"
                                HeightRequest="56">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="28,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Label Text="👤"
                                       FontSize="20"
                                       VerticalOptions="Center" />

                                <Entry Grid.Column="1"
                                       x:Name="NewUsernameEntry"
                                       Placeholder="Enter username"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F172A"
                                       PlaceholderColor="#94A3B8"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Password"
                               FontSize="14"
                               TextColor="#334155" />

                        <Border Background="#FFFFFF"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                Padding="16,0"
                                HeightRequest="56">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="28,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Label Text="🔒"
                                       FontSize="20"
                                       VerticalOptions="Center" />

                                <Entry Grid.Column="1"
                                       x:Name="NewPasswordEntry"
                                       Placeholder="Enter password"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F172A"
                                       PlaceholderColor="#94A3B8"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Register button -->
                    <Button Text="Continue"
                            HeightRequest="56"
                            CornerRadius="18"
                            Margin="0,12,0,0"
                            FontSize="18"
                            FontAttributes="Bold"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            Clicked="OnRegisterSubmitClicked" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             Margin="0,8,0,0"
                             Color="#E5E7EB" />

                    <!-- Back to login -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="6"
                                           Margin="0,8,0,0">
                        <Label Text="Already have an account?"
                               FontSize="14"
                               TextColor="#64748B"
                               VerticalOptions="Center" />

                        <Button Text="Back to login"
                                BackgroundColor="Transparent"
                                TextColor="#2563EB"
                                FontAttributes="Bold"
                                Padding="0"
                                Clicked="OnBackToLoginClicked" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="Secure • Reliable • Community-Friendly"
                   Margin="0,24,0,0"
                   FontSize="13"
                   TextColor="#DBEAFE"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>