<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="parcel_station1.Pages.RegisterPage"
             Title="Register"
             BackgroundColor="#F5F7FB">

    <ScrollView>
        <VerticalStackLayout Padding="24,30,24,24"
                             Spacing="20"
                             MaximumWidthRequest="520"
                             HorizontalOptions="Center">

            <!-- 顶部品牌区域 -->
            <VerticalStackLayout Spacing="10"
                                 HorizontalOptions="Center">

                <Frame WidthRequest="82"
                       HeightRequest="82"
                       CornerRadius="22"
                       Padding="0"
                       HasShadow="False"
                       BackgroundColor="#4F46E5"
                       HorizontalOptions="Center">
                    <Label Text="📦"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="White" />
                </Frame>

                <Label Text="Parcel Station"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#0F172A" />

                <Label Text="创建您的账户"
                       FontSize="16"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- 注册卡片 -->
            <Frame CornerRadius="26"
                   Padding="26"
                   Margin="0,20,0,0"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="#E5E7EB">

                <VerticalStackLayout Spacing="18">

                    <Label Text="注册新账户"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <!-- 用户名 -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="用户名"
                               FontSize="14"
                               TextColor="#334155" />

                        <Frame CornerRadius="16"
                               Padding="14,10"
                               HasShadow="False"
                               BackgroundColor="#F8FAFC"
                               BorderColor="#DCE3EC">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="👤"
                                       FontSize="20"
                                       VerticalOptions="Center" />

                                <Entry x:Name="NewUsernameEntry"
                                       Placeholder="请输入用户名"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F172A"
                                       PlaceholderColor="#94A3B8"
                                       HorizontalOptions="FillAndExpand" />
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- 密码 -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="密码"
                               FontSize="14"
                               TextColor="#334155" />

                        <Frame CornerRadius="16"
                               Padding="14,10"
                               HasShadow="False"
                               BackgroundColor="#F8FAFC"
                               BorderColor="#DCE3EC">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🔒"
                                       FontSize="20"
                                       VerticalOptions="Center" />

                                <Entry x:Name="NewPasswordEntry"
                                       Placeholder="请输入密码"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F172A"
                                       PlaceholderColor="#94A3B8"
                                       HorizontalOptions="FillAndExpand" />
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- 注册按钮 -->
                    <Button Text="注册"
                            HeightRequest="56"
                            CornerRadius="18"
                            FontSize="20"
                            FontAttributes="Bold"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            Clicked="OnRegisterSubmitClicked" />

                    <!-- 返回登录 -->
                    <Grid ColumnDefinitions="*,Auto,*"
                          ColumnSpacing="12"
                          Margin="0,6,0,0">
                        <BoxView Grid.Column="0"
                                 HeightRequest="1"
                                 Color="#E5E7EB"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="或"
                               TextColor="#94A3B8"
                               FontSize="14"
                               HorizontalOptions="Center" />
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 Color="#E5E7EB"
                                 VerticalOptions="Center" />
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="6">
                        <Label Text="已经有账户？"
                               FontSize="15"
                               TextColor="#64748B"
                               VerticalOptions="Center" />

                        <Button Text="返回登录"
                                BackgroundColor="Transparent"
                                TextColor="#2563EB"
                                FontAttributes="Bold"
                                Padding="0"
                                Clicked="OnBackToLoginClicked" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- 底部小字 -->
            <Label Text="© 2026 Parcel Station"
                   FontSize="12"
                   TextColor="#94A3B8"
                   HorizontalOptions="Center"
                   Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>